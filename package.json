{
  "name": "4af-components",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19.0",
    "pnpm": ">=12.11.2"
  },
  "scripts": {
    "dev": "next dev",
    "build": "pnpm drawings:build && pnpm registry:build && next build && node scripts/finalize-export.mjs",
    "start": "wrangler dev",
    "deploy": "wrangler deploy",
    "test:export": "node scripts/check-export.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "registry:validate": "shadcn registry validate",
    "registry:build": "node scripts/clean-registry.mjs && shadcn build",
    "benchmark:site": "node scripts/benchmark-site.mjs",
    "skills:sync": "node scripts/sync-skills.mjs",
    "skills:check": "node scripts/sync-skills.mjs --check",
    "postinstall": "pnpm skills:sync",
    "drawings:build": "node scripts/build-drawings.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@tanstack/react-table": "9.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fumadocs-core": "16.19.7",
    "fumadocs-mdx": "15.6.4",
    "fumadocs-ui": "16.19.7",
    "lucide-react": "^1.80.0",
    "motion": "^14.14.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "tabbable": "^6.5.2",
    "tailwind-merge": "^3.7.1",
    "torph": "0.1.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.10",
    "@types/react": "^19.3.2",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.15.0",
    "eslint-config-next": "^16.4.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^31.0.1",
    "playwright-core": "^1.65.1",
    "postcss": "^8.5.33",
    "shadcn": "4.23.0",
    "tailwindcss": "^4.3.5",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-native": "npm:typescript@^7.0.2",
    "vitest": "^5.1.2",
    "wrangler": "^4.168.0",
    "yaml": "2.9.1"
  }
}
