{
  "name": "4af-components",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19.0",
    "pnpm": ">=12.11.2"
  },
  "scripts": {
    "dev": "next dev",
    "build": "pnpm drawings:build && pnpm registry:build && next build && node scripts/finalize-export.mjs",
    "start": "wrangler dev",
    "deploy": "wrangler deploy",
    "test:export": "node scripts/check-export.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "registry:validate": "shadcn registry validate",
    "registry:build": "node scripts/clean-registry.mjs && shadcn build",
    "benchmark:site": "node scripts/benchmark-site.mjs",
    "skills:sync": "node scripts/sync-skills.mjs",
    "skills:check": "node scripts/sync-skills.mjs --check",
    "postinstall": "pnpm skills:sync",
    "drawings:build": "node scripts/build-drawings.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@tanstack/react-table": "9.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fumadocs-core": "16.18.3",
    "fumadocs-mdx": "15.5.2",
    "fumadocs-ui": "16.18.3",
    "lucide-react": "^1.70.0",
    "motion": "^14.10.1",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "tabbable": "^6.5.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "playwright-core": "^1.65.0",
    "postcss": "^8.5.32",
    "shadcn": "4.23.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "wrangler": "^4.158.0",
    "yaml": "2.9.1"
  }
}
