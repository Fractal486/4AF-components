          "background": "oklch(0.1448 0 0)",
          "surface": "oklch(0.178 0 0)",
          "surface-raised": "oklch(0.2 0 0)",
          "muted": "oklch(0.205 0 0)",
          "foreground": "oklch(0.985 0.002 70)",
          "muted-foreground": "oklch(0.716 0.01 70)",
          "subtle-foreground": "oklch(0.582 0.011 70)",
          "border": "oklch(0.235 0 0)",
          "border-strong": "oklch(0.285 0 0)",
          "ring": "oklch(0.702 0.176 52)",
          "primary": "oklch(0.968 0.004 70)",
          "primary-foreground": "oklch(0.155 0.006 70)",
          "primary-hover": "oklch(1 0 0)",
          "destructive": "oklch(0.6 0.225 26)",
          "destructive-foreground": "oklch(1 0 0)",
          "destructive-hover": "oklch(0.62 0.208 25)",
          "success": "oklch(0.52 0.13 152)",
          "success-foreground": "oklch(1 0 0)",
          "text-shimmer-base": "var(--muted-foreground)",
          "text-shimmer-highlight": "oklch(1 0 0)",
          "elevation-border": "0 0 0 1px oklch(1 0 0 / 0.08)",
          "elevation-raised": "0 0 0 1px oklch(1 0 0 / 0.1), 0 8px 16px -8px oklch(0 0 0 / 0.6)",
          "elevation-overlay": "0 0 0 1px oklch(1 0 0 / 0.12), 0 16px 32px -12px oklch(0 0 0 / 0.7)",
          "elevation-overlay-drop": "0 16px 32px -12px oklch(0 0 0 / 0.7)"
        }
      },
      "css": {
        "@keyframes icon-pop": {
          "0%": {
            "scale": "1"
          },
          "40%": {
            "scale": "1.25"
          },
          "100%": {
            "scale": "1"
          }
        },
        "@keyframes text-shimmer": {
          "from": {
            "background-position": "200% 0"
          },
          "to": {
            "background-position": "-200% 0"
          }
        },
        "@media (prefers-reduced-motion: reduce)": {
          ":root": {
            "--duration-fast": "1ms",
            "--duration-base": "1ms",
            "--duration-slow": "1ms",
            "--duration-slower": "1ms"
          }
        }
      }
