          "color-muted-foreground": "var(--muted-foreground)",
          "color-subtle-foreground": "var(--subtle-foreground)",
          "color-border": "var(--border)",
          "color-border-strong": "var(--border-strong)",
          "color-ring": "var(--ring)",
          "color-primary": "var(--primary)",
          "color-primary-foreground": "var(--primary-foreground)",
          "color-primary-hover": "var(--primary-hover)",
          "color-destructive": "var(--destructive)",
          "color-destructive-foreground": "var(--destructive-foreground)",
          "color-destructive-hover": "var(--destructive-hover)",
          "color-success": "var(--success)",
          "color-success-foreground": "var(--success-foreground)",
          "color-neutral-50": "oklch(0.985 0.002 70)",
          "color-neutral-100": "oklch(0.968 0.004 70)",
          "color-neutral-200": "oklch(0.928 0.006 70)",
          "color-neutral-300": "oklch(0.874 0.008 70)",
          "color-neutral-400": "oklch(0.716 0.01 70)",
          "color-neutral-500": "oklch(0.582 0.011 70)",
          "color-neutral-600": "oklch(0.472 0.01 70)",
          "color-neutral-700": "oklch(0.396 0.009 70)",
          "color-neutral-800": "oklch(0.288 0.008 70)",
          "color-neutral-900": "oklch(0.216 0.007 70)",
          "color-neutral-950": "oklch(0.155 0.006 70)",
          "color-neutral-1000": "oklch(0.118 0.005 70)",
          "color-accent-400": "oklch(0.774 0.153 60)",
          "color-accent-500": "oklch(0.702 0.176 52)",
          "color-accent-700": "oklch(0.44 0.126 42)",
          "radius-xs": "3px",
          "radius-sm": "5px",
          "radius-md": "7px",
          "radius-lg": "10px",
          "radius-xl": "14px",
          "radius-2xl": "20px",
          "radius-3xl": "28px",
          "text-2xs": "0.6875rem",
          "text-2xs--line-height": "1.0909",
